#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        forty_two: forty_two {
            label = "ZM_forty_two";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp N4>
                , <&macro_tap &kp N2>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &gresc          &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp BSPC
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T                           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp DEL
                &kp LSHIFT      &kp A           &kp S           &kp D           &kp F           &kp G           &mo RAISE       &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT
                &kp LCTRL       &kp Z           &kp X           &kp C           &kp V           &kp B                           &kp N           &kp M           &kp COMMA       &kp DOT         &kp SLASH       &mt RSHIFT RET
                                                &kp LALT        &kp LGUI        &kp SPACE       &kp LEFT                        &kp RIGHT       &kp SPACE       &mo RAISE       &kp RCTRL
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp TILDE       &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT                       &kp CARET       &kp AMPS        &kp STAR        &kp LPAR        &kp RPAR        &kp BSPC
                &kp TILDE       &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT                       &kp CARET       &kp AMPS        &kp STAR        &kp LPAR        &kp RPAR        &kp DEL
                &kp DEL         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp C_PLAY      &kp F6          &kp MINUS       &kp PLUS        &kp LBKT        &kp RBKT        &kp PIPE
                &kp LSHIFT      &kp F7          &kp F8          &kp F9          &kp F10         &kp F11                         &kp F12         &none           &kp LCTRL       &kp HOME        &kp END         &none
                                                &none           &trans          &none           &kp C_VOL_DN                    &kp C_VOL_UP    &none           &mo RAISE       &kp C_NEXT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
                &kp TILDE       &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11
                &trans          &trans          &trans          &trans          &trans          &trans                          &trans          &trans          &kp UP          &kp MINUS       &kp KP_EQUAL    &kp F12
                &caps_word      &trans          &trans          &trans          &trans          &trans          &mo LOWER       &trans          &kp LEFT        &kp DOWN        &kp RIGHT       &trans          &kp BSLH
                &trans          &trans          &trans          &trans          &trans          &trans                          &trans          &trans          &trans          &kp LBKT        &kp RBKT        &none
                                                &none           &mo LOWER       &trans          &kp DOWN                        &kp UP          &none           &trans          &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
                &bootloader     &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                          &kp A           &kp N7          &kp N8          &kp N9          &kp N0          &studio_unlock
                &bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                    &kp Y           &kp U           &kp I           &kp O           &kp P           &kp DEL
                &out OUT_TOG    &bt BT_CLR_ALL  &kp S           &kp D           &kp F           &kp G           &tog ADJUST     &kp H           &kp J           &kp K           &rgb_ug RGB_TOG &kp SEMI        &kp SQT
                &kp LSHIFT      &kp Z           &kp X           &kp C           &kp V           &rgb_ug RGB_HUD                 &rgb_ug RGB_HUI &kp M           &kp COMMA       &kp DOT         &kp SLASH       &mt RSHIFT RET
                                                &kp LALT        &trans          &kp SPACE       &rgb_ug RGB_BRD                 &rgb_ug RGB_BRI &kp SPACE       &trans          &kp K_CMENU
            >;
        };

        spare_layer_1 {
            status = "reserved";
        };

        spare_layer_2 {
            status = "reserved";
        };
    };
};
